---
import App from '../layouts/App.astro';

const PLATFORMS = [
  { value: '',               label: 'All platforms' },
  { value: 'greenhouse',     label: 'Greenhouse' },
  { value: 'lever',          label: 'Lever' },
  { value: 'ashby',          label: 'Ashby' },
  { value: 'workday',        label: 'Workday' },
  { value: 'smartrecruiters',label: 'SmartRecruiters' },
  { value: 'bamboohr',       label: 'BambooHR' },
  { value: 'unknown',        label: 'Custom page' },
];
---

<App title="Discover">
  <div x-data="discoverPage()" x-init="init()">

    <!-- Header -->
    <div class="mb-6">
      <h1 class="text-2xl font-bold text-gray-900">Discover companies</h1>
      <p class="mt-1 text-sm text-gray-500">
        Browse companies we've found and add them to your watchlist in one click.
      </p>
    </div>

    <!-- Unverified notice -->
    <div x-show="user && !user.email_verified" x-cloak class="alert-info mb-6">
      <svg class="h-4 w-4 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" d="M21.75 6.75v10.5a2.25 2.25 0 01-2.25 2.25h-15a2.25 2.25 0 01-2.25-2.25V6.75m19.5 0A2.25 2.25 0 0019.5 4.5h-15a2.25 2.25 0 00-2.25 2.25m19.5 0v.243a2.25 2.25 0 01-1.07 1.916l-7.5 4.615a2.25 2.25 0 01-2.36 0L3.32 8.91a2.25 2.25 0 01-1.07-1.916V6.75" />
      </svg>
      <span>Verify your email to start watching companies. Check your inbox for the verification link.</span>
    </div>

    <!-- Limit reached notice -->
    <div x-show="user && watcherCount >= user.max_watchers" x-cloak class="alert-info mb-6">
      <svg class="h-4 w-4 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" d="M11.25 11.25l.041-.02a.75.75 0 011.063.852l-.708 2.836a.75.75 0 001.063.853l.041-.021M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
      </svg>
      <span>
        You've reached your <strong x-text="user?.max_watchers"></strong>-watcher limit.
        <a href="/account" class="font-semibold underline">Upgrade your plan</a> to watch more companies.
      </span>
    </div>

    <!-- Search + filter bar -->
    <div class="mb-6 flex flex-col gap-3 sm:flex-row sm:items-center">
      <div class="relative flex-1">
        <svg class="pointer-events-none absolute left-3 top-1/2 h-4 w-4 -translate-y-1/2 text-gray-400" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-5.197-5.197m0 0A7.5 7.5 0 105.196 5.196a7.5 7.5 0 0010.607 10.607z" />
        </svg>
        <input
          type="text"
          placeholder="Search companies…"
          x-model.debounce.300ms="query"
          @input="search()"
          class="field pl-9"
        />
      </div>

      <select x-model="platform" @change="search()" class="field sm:w-48">
        {PLATFORMS.map(p => (
          <option value={p.value}>{p.label}</option>
        ))}
      </select>
    </div>

    <!-- Result count -->
    <p class="mb-4 text-sm text-gray-500" x-show="!loading">
      <span x-text="total.toLocaleString()"></span> companies found
      <span x-show="watchedCount > 0" class="ml-2 text-brand-600 font-medium">
        · <span x-text="watchedCount"></span> watched
      </span>
    </p>

    <!-- Loading skeleton -->
    <div x-show="loading" class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4">
      <template x-for="i in [1,2,3,4,5,6,7,8]">
        <div class="h-28 animate-pulse rounded-lg bg-gray-100"></div>
      </template>
    </div>

    <!-- Empty state -->
    <div x-show="!loading && companies.length === 0" class="card py-20 text-center">
      <svg class="mx-auto mb-4 h-10 w-10 text-gray-300" fill="none" viewBox="0 0 24 24" stroke-width="1" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-5.197-5.197m0 0A7.5 7.5 0 105.196 5.196a7.5 7.5 0 0010.607 10.607z" />
      </svg>
      <p class="text-sm text-gray-500">No companies match your search.</p>
    </div>

    <!-- Company grid -->
    <div x-show="!loading && companies.length > 0"
         class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4">
      <template x-for="c in companies" :key="c.id">
        <div
          class="card flex flex-col justify-between p-4 transition-shadow hover:shadow-md"
          :class="c.watcher_id ? 'ring-2 ring-brand-600 ring-inset' : ''"
        >
          <div class="mb-3">
            <!-- Platform badge -->
            <div class="mb-2 flex items-center justify-between">
              <span
                class="inline-flex items-center gap-1 rounded-full px-2 py-0.5 text-xs font-medium"
                :class="platformBadgeClass(c.platform)"
                x-text="platformLabel(c.platform)"
              ></span>
              <!-- Watching indicator -->
              <span x-show="c.watcher_id" class="text-xs font-semibold text-brand-600">Watching</span>
            </div>

            <!-- Company name -->
            <p class="font-semibold text-gray-900 leading-snug" x-text="c.name"></p>
            <!-- Domain -->
            <a
              :href="`https://${c.domain}`"
              target="_blank"
              rel="noopener"
              class="mt-0.5 block truncate text-xs text-gray-400 hover:text-brand-600"
              x-text="c.domain"
            ></a>
          </div>

          <!-- Signals link -->
          <a :href="`/company?id=${c.id}`"
             class="mb-2 block text-center text-xs text-gray-400 hover:text-brand-600 transition-colors">
            View hiring signals →
          </a>

          <!-- Watch / Unwatch button -->
          <button
            @click="toggle(c)"
            :disabled="toggling === c.id || (!c.watcher_id && atLimit)"
            class="w-full rounded-md px-3 py-1.5 text-xs font-semibold transition-colors focus:outline-none focus:ring-2 focus:ring-offset-1"
            :class="c.watcher_id
              ? 'bg-brand-50 text-brand-700 hover:bg-red-50 hover:text-red-600 focus:ring-brand-600'
              : 'bg-brand-600 text-white hover:bg-brand-700 focus:ring-brand-600 disabled:opacity-40 disabled:cursor-not-allowed'"
            :title="!c.watcher_id && atLimit ? 'Upgrade your plan to watch more companies' : ''"
          >
            <span x-show="toggling !== c.id">
              <span x-show="c.watcher_id">Watching ✓</span>
              <span x-show="!c.watcher_id">+ Watch</span>
            </span>
            <span x-show="toggling === c.id" class="flex items-center justify-center gap-1">
              <svg class="animate-spin h-3 w-3" fill="none" viewBox="0 0 24 24">
                <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4z"></path>
              </svg>
              …
            </span>
          </button>
        </div>
      </template>
    </div>

    <!-- Load more -->
    <div x-show="hasMore && !loading" class="mt-8 text-center">
      <button @click="loadMore()" :disabled="loadingMore" class="btn-secondary">
        <span x-text="loadingMore ? 'Loading…' : 'Load more'"></span>
      </button>
    </div>

  </div>

  <script is:inline>
    const PAGE = 48;

    const PLATFORM_LABELS = {
      greenhouse:      'Greenhouse',
      lever:           'Lever',
      ashby:           'Ashby',
      workday:         'Workday',
      smartrecruiters: 'SmartRecruiters',
      bamboohr:        'BambooHR',
      rippling:        'Rippling',
      unknown:         'Custom',
    };

    const PLATFORM_BADGE = {
      greenhouse:      'bg-green-100 text-green-800',
      lever:           'bg-blue-100 text-blue-800',
      ashby:           'bg-violet-100 text-violet-800',
      workday:         'bg-orange-100 text-orange-800',
      smartrecruiters: 'bg-rose-100 text-rose-800',
      bamboohr:        'bg-teal-100 text-teal-800',
      rippling:        'bg-indigo-100 text-indigo-800',
      unknown:         'bg-gray-100 text-gray-600',
    };

    function discoverPage() {
      return {
        user: null,
        companies: [],
        total: 0,
        hasMore: false,
        offset: 0,
        loading: true,
        loadingMore: false,
        query: '',
        platform: '',
        toggling: null,    // company id currently being toggled
        watcherCount: 0,   // current user watcher count (for limit check)

        async init() {
          window.addEventListener('user-loaded', async (e) => {
            this.user = e.detail;
            // Load watcher count for limit awareness
            const r = await fetch('/api/watches');
            if (r.ok) this.watcherCount = (await r.json()).length;
          });
          await this.search();
        },

        async search() {
          this.loading = true;
          this.offset = 0;
          this.companies = [];
          const data = await this.fetch(0);
          this.companies = data.items;
          this.total = data.total;
          this.hasMore = data.has_more;
          this.loading = false;
        },

        async loadMore() {
          this.loadingMore = true;
          this.offset += PAGE;
          const data = await this.fetch(this.offset);
          this.companies = [...this.companies, ...data.items];
          this.hasMore = data.has_more;
          this.loadingMore = false;
        },

        async fetch(offset) {
          const params = new URLSearchParams({ limit: PAGE, offset });
          if (this.query.trim()) params.set('q', this.query.trim());
          if (this.platform) params.set('platform', this.platform);
          const r = await fetch(`/api/companies?${params}`);
          return r.ok ? r.json() : { items: [], total: 0, has_more: false };
        },

        async toggle(company) {
          if (!this.user) return;
          if (!this.user.email_verified) return;

          this.toggling = company.id;
          try {
            if (company.watcher_id) {
              // Unwatch
              await fetch(`/api/companies/${company.id}/watch`, { method: 'DELETE' });
              company.watcher_id = null;
              this.watcherCount = Math.max(0, this.watcherCount - 1);
            } else {
              // Watch
              const r = await fetch(`/api/companies/${company.id}/watch`, { method: 'POST' });
              if (r.ok) {
                const { watcher_id } = await r.json();
                company.watcher_id = watcher_id;
                this.watcherCount += 1;
              } else if (r.status === 402) {
                window.location.href = '/account';
              }
            }
          } finally {
            this.toggling = null;
          }
        },

        get atLimit() {
          return this.user && this.watcherCount >= this.user.max_watchers;
        },

        get watchedCount() {
          return this.companies.filter(c => c.watcher_id).length;
        },

        platformLabel(p) {
          return PLATFORM_LABELS[p] || p || 'Unknown';
        },

        platformBadgeClass(p) {
          return PLATFORM_BADGE[p] || PLATFORM_BADGE.unknown;
        },
      };
    }
  </script>
</App>
