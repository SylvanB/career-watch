---
import Base from '../layouts/Base.astro';
---

<Base title="Set new password">
  <div class="min-h-screen bg-gray-50 flex flex-col justify-center py-12 px-4 sm:px-6 lg:px-8">
    <div class="sm:mx-auto sm:w-full sm:max-w-md">
      <a href="/" class="flex justify-center items-center gap-2 font-bold text-gray-900 text-xl tracking-tight">
        <svg class="h-7 w-7 text-brand-600" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 12l8.954-8.955c.44-.439 1.152-.439 1.591 0L21.75 12M4.5 9.75v10.125c0 .621.504 1.125 1.125 1.125H9.75v-4.875c0-.621.504-1.125 1.125-1.125h2.25c.621 0 1.125.504 1.125 1.125V21h4.125c.621 0 1.125-.504 1.125-1.125V9.75M8.25 21h8.25" />
        </svg>
        CareerWatch
      </a>
      <h2 class="mt-6 text-center text-2xl font-bold text-gray-900">Set a new password</h2>
    </div>

    <div class="mt-8 sm:mx-auto sm:w-full sm:max-w-md">
      <div class="card px-8 py-10" x-data="resetPassword()" x-init="init()">

        <!-- Invalid / missing token -->
        <div x-show="!token" x-cloak class="text-center">
          <p class="text-sm text-gray-500 mb-4">This reset link is missing or invalid.</p>
          <a href="/forgot-password" class="btn-primary w-full justify-center">Request a new link</a>
        </div>

        <!-- Form -->
        <form x-show="token && !done" @submit.prevent="submit()" class="space-y-5">
          <div x-show="error" class="alert-error text-sm" x-text="error"></div>

          <div>
            <label for="pw" class="label">New password</label>
            <input
              id="pw"
              type="password"
              required
              minlength="8"
              autocomplete="new-password"
              x-model="password"
              class="field"
              placeholder="At least 8 characters"
            />
          </div>

          <button type="submit" class="btn-primary w-full" :disabled="loading">
            <span x-text="loading ? 'Saving…' : 'Set new password'"></span>
          </button>
        </form>

        <!-- Success -->
        <div x-show="done" x-cloak class="text-center">
          <div class="mx-auto mb-4 flex h-12 w-12 items-center justify-center rounded-full bg-green-100">
            <svg class="h-6 w-6 text-green-600" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5" />
            </svg>
          </div>
          <h3 class="font-semibold text-gray-900 mb-2">Password updated</h3>
          <p class="text-sm text-gray-500 mb-6">You've been signed out of all devices. Please log in with your new password.</p>
          <a href="/login" class="btn-primary w-full justify-center">Sign in</a>
        </div>

      </div>
    </div>
  </div>

  <script is:inline>
    function resetPassword() {
      return {
        token: '',
        password: '',
        error: '',
        loading: false,
        done: false,

        init() {
          this.token = new URLSearchParams(window.location.search).get('token') || '';
        },

        async submit() {
          this.error = '';
          this.loading = true;
          try {
            const res = await fetch('/auth/reset-password', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({ token: this.token, new_password: this.password }),
            });
            if (res.ok) {
              this.done = true;
            } else {
              const data = await res.json().catch(() => ({}));
              this.error = data.error || 'The link is invalid or has expired.';
            }
          } catch {
            this.error = 'Could not reach the server. Please try again.';
          } finally {
            this.loading = false;
          }
        },
      };
    }
  </script>
</Base>
