---
import App from '../layouts/App.astro';
---

<App title="Dashboard">
  <div x-data="dashboard()" x-init="init()">

    <!-- Page header -->
    <div class="mb-8 flex items-center justify-between">
      <div>
        <h1 class="text-2xl font-bold text-gray-900">Watchers</h1>
        <p class="mt-1 text-sm text-gray-500">
          Monitoring <span class="font-medium text-gray-700" x-text="watchers.length"></span>
          of <span class="font-medium text-gray-700" x-text="user?.max_watchers ?? '…'"></span> companies
        </p>
      </div>
      <button
        @click="showAddModal = true"
        class="btn-primary"
        :disabled="atLimit"
        :title="atLimit ? 'Upgrade your plan to add more watchers' : ''"
      >
        <svg class="mr-2 h-4 w-4" fill="none" viewBox="0 0 24 24" stroke-width="2.5" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15" />
        </svg>
        Add watcher
      </button>
    </div>

    <!-- Limit reached banner -->
    <div x-show="atLimit" x-transition class="alert-info mb-6">
      <svg class="h-4 w-4 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" d="M11.25 11.25l.041-.02a.75.75 0 011.063.852l-.708 2.836a.75.75 0 001.063.853l.041-.021M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
      </svg>
      <span>
        You've reached your plan limit of <strong x-text="user?.max_watchers"></strong> watchers.
        <a href="/account" class="font-semibold underline">Upgrade your plan</a> to monitor more companies.
      </span>
    </div>

    <!-- Email verification banner -->
    <div x-show="user && !user.email_verified" x-transition class="alert-info mb-6">
      <svg class="h-4 w-4 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" d="M21.75 6.75v10.5a2.25 2.25 0 01-2.25 2.25h-15a2.25 2.25 0 01-2.25-2.25V6.75m19.5 0A2.25 2.25 0 0019.5 4.5h-15a2.25 2.25 0 00-2.25 2.25m19.5 0v.243a2.25 2.25 0 01-1.07 1.916l-7.5 4.615a2.25 2.25 0 01-2.36 0L3.32 8.91a2.25 2.25 0 01-1.07-1.916V6.75" />
      </svg>
      <span>Please verify your email address before creating watchers. Check your inbox for the verification link.</span>
    </div>

    <!-- Loading skeleton -->
    <div x-show="loading" class="space-y-3">
      <div class="h-16 animate-pulse rounded-lg bg-gray-100"></div>
      <div class="h-16 animate-pulse rounded-lg bg-gray-100"></div>
      <div class="h-16 animate-pulse rounded-lg bg-gray-100"></div>
    </div>

    <!-- Empty state -->
    <div
      x-show="!loading && watchers.length === 0"
      class="card flex flex-col items-center justify-center py-20 text-center"
    >
      <svg class="h-12 w-12 text-gray-300 mb-4" fill="none" viewBox="0 0 24 24" stroke-width="1" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" d="M2.036 12.322a1.012 1.012 0 010-.639C3.423 7.51 7.36 4.5 12 4.5c4.638 0 8.573 3.007 9.963 7.178.07.207.07.431 0 .639C20.577 16.49 16.64 19.5 12 19.5c-4.638 0-8.573-3.007-9.963-7.178z" />
        <path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
      </svg>
      <h3 class="text-base font-semibold text-gray-900 mb-2">No watchers yet</h3>
      <p class="text-sm text-gray-500 mb-6 max-w-xs">
        Add your first company career page to start getting job change alerts.
      </p>
      <button @click="showAddModal = true" class="btn-primary">Add your first watcher</button>
    </div>

    <!-- Watcher table -->
    <div x-show="!loading && watchers.length > 0" class="card overflow-hidden">
      <table class="min-w-full divide-y divide-gray-200">
        <thead class="bg-gray-50">
          <tr>
            <th class="px-6 py-3 text-left text-xs font-semibold uppercase tracking-wider text-gray-500">Company</th>
            <th class="px-6 py-3 text-left text-xs font-semibold uppercase tracking-wider text-gray-500 hidden sm:table-cell">URL</th>
            <th class="px-6 py-3 text-left text-xs font-semibold uppercase tracking-wider text-gray-500 hidden md:table-cell">Last checked</th>
            <th class="px-6 py-3 text-left text-xs font-semibold uppercase tracking-wider text-gray-500 hidden md:table-cell">Selector</th>
            <th class="relative px-6 py-3"><span class="sr-only">Actions</span></th>
          </tr>
        </thead>
        <tbody class="divide-y divide-gray-100 bg-white">
          <template x-for="w in watchers" :key="w.id">
            <tr class="hover:bg-gray-50 transition-colors">
              <td class="px-6 py-4">
                <span class="font-medium text-gray-900 text-sm" x-text="w.company_name"></span>
              </td>
              <td class="px-6 py-4 hidden sm:table-cell">
                <a
                  :href="w.url"
                  target="_blank"
                  rel="noopener"
                  class="text-xs text-gray-400 hover:text-brand-600 truncate max-w-xs block transition-colors"
                  x-text="w.url.replace(/^https?:\/\//, '')"
                ></a>
              </td>
              <td class="px-6 py-4 hidden md:table-cell">
                <span
                  class="text-xs text-gray-400"
                  x-text="w.last_checked_at ? formatDate(w.last_checked_at) : 'Never'"
                ></span>
              </td>
              <td class="px-6 py-4 hidden md:table-cell">
                <span
                  x-show="w.job_selector"
                  class="inline-flex items-center rounded bg-gray-100 px-2 py-0.5 font-mono text-xs text-gray-600"
                  x-text="w.job_selector"
                ></span>
                <span x-show="!w.job_selector" class="text-xs text-gray-300">—</span>
              </td>
              <td class="px-6 py-4 text-right">
                <button
                  @click="deleteWatcher(w.id, w.company_name)"
                  class="text-xs text-gray-400 hover:text-red-600 transition-colors font-medium"
                >
                  Remove
                </button>
              </td>
            </tr>
          </template>
        </tbody>
      </table>
    </div>

    <!-- ── Add watcher modal ── -->
    <div
      x-show="showAddModal"
      x-transition.opacity
      class="fixed inset-0 z-50 flex items-center justify-center bg-black/40 px-4"
      @keydown.escape.window="showAddModal = false"
    >
      <div
        class="card w-full max-w-md p-8"
        x-transition.scale
        @click.outside="showAddModal = false"
      >
        <div class="mb-6 flex items-center justify-between">
          <h2 class="text-lg font-semibold text-gray-900">Add a watcher</h2>
          <button @click="showAddModal = false" class="text-gray-400 hover:text-gray-600">
            <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
            </svg>
          </button>
        </div>

        <div x-show="addError" class="alert-error mb-4 text-xs">
          <span x-text="addError"></span>
        </div>

        <form @submit.prevent="addWatcher()" class="space-y-4">
          <div>
            <label class="label" for="add-name">Company name</label>
            <input id="add-name" type="text" required x-model="newWatcher.company_name"
                   class="field" placeholder="Stripe" />
          </div>
          <div>
            <label class="label" for="add-url">Careers page URL</label>
            <input id="add-url" type="url" required x-model="newWatcher.url"
                   class="field" placeholder="https://stripe.com/jobs" />
          </div>
          <div>
            <label class="label" for="add-selector">
              CSS selector
              <span class="font-normal text-gray-400">(optional)</span>
            </label>
            <input id="add-selector" type="text" x-model="newWatcher.job_selector"
                   class="field font-mono text-xs" placeholder="div.job-card h3.job-title" />
            <p class="mt-1 text-xs text-gray-400">
              When set, individual job titles are tracked instead of the full page.
            </p>
          </div>

          <div class="flex gap-3 pt-2">
            <button type="submit" class="btn-primary flex-1" :disabled="addLoading">
              <span x-text="addLoading ? 'Adding…' : 'Add watcher'"></span>
            </button>
            <button type="button" @click="showAddModal = false" class="btn-secondary">
              Cancel
            </button>
          </div>
        </form>
      </div>
    </div>

  </div>

  <script>
    function dashboard() {
      return {
        user: null,
        watchers: [],
        loading: true,
        showAddModal: false,
        newWatcher: { company_name: '', url: '', job_selector: '' },
        addError: '',
        addLoading: false,

        async init() {
          // Wait for the app shell to load the user
          window.addEventListener('user-loaded', (e) => {
            this.user = e.detail;
          });
          await this.loadWatchers();
        },

        async loadWatchers() {
          this.loading = true;
          try {
            const res = await fetch('/api/watches');
            if (res.ok) this.watchers = await res.json();
          } finally {
            this.loading = false;
          }
        },

        async addWatcher() {
          this.addError = '';
          this.addLoading = true;
          try {
            const res = await fetch('/api/watches', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({
                company_name: this.newWatcher.company_name,
                url: this.newWatcher.url,
                job_selector: this.newWatcher.job_selector || null,
              }),
            });
            if (res.ok) {
              this.showAddModal = false;
              this.newWatcher = { company_name: '', url: '', job_selector: '' };
              await this.loadWatchers();
            } else {
              const d = await res.json();
              this.addError = d.error || 'Failed to add watcher.';
            }
          } catch {
            this.addError = 'Could not reach the server.';
          } finally {
            this.addLoading = false;
          }
        },

        async deleteWatcher(id, name) {
          if (!confirm(`Remove watcher for "${name}"?`)) return;
          await fetch(`/api/watches/${id}`, { method: 'DELETE' });
          await this.loadWatchers();
        },

        get atLimit() {
          return this.user && this.watchers.length >= this.user.max_watchers;
        },

        formatDate(iso) {
          return new Date(iso).toLocaleString(undefined, {
            month: 'short', day: 'numeric',
            hour: '2-digit', minute: '2-digit',
          });
        },
      };
    }
  </script>
</App>
