---
import App from '../layouts/App.astro';
---

<App title="Dashboard">
  <div x-data="dashboard()" x-init="init()">

    <!-- Page header -->
    <div class="mb-8 flex items-center justify-between">
      <div>
        <h1 class="text-2xl font-bold text-gray-900">Watchers</h1>
        <p class="mt-1 text-sm text-gray-500">
          Monitoring <span class="font-medium text-gray-700" x-text="watchers.length"></span>
          of <span class="font-medium text-gray-700" x-text="user?.max_watchers ?? '…'"></span> companies
        </p>
      </div>
      <button
        @click="showAddModal = true"
        class="btn-primary"
        :disabled="atLimit"
        :title="atLimit ? 'Upgrade your plan to add more watchers' : ''"
      >
        <svg class="mr-2 h-4 w-4" fill="none" viewBox="0 0 24 24" stroke-width="2.5" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15" />
        </svg>
        Add watcher
      </button>
    </div>

    <!-- Limit reached banner -->
    <div x-show="atLimit" x-transition class="alert-info mb-6">
      <svg class="h-4 w-4 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" d="M11.25 11.25l.041-.02a.75.75 0 011.063.852l-.708 2.836a.75.75 0 001.063.853l.041-.021M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
      </svg>
      <span>
        You've reached your plan limit of <strong x-text="user?.max_watchers"></strong> watchers.
        <a href="/account" class="font-semibold underline">Upgrade your plan</a> to monitor more companies.
      </span>
    </div>

    <!-- Email verification banner -->
    <div x-show="user && !user.email_verified" x-transition class="alert-info mb-6">
      <svg class="h-4 w-4 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" d="M21.75 6.75v10.5a2.25 2.25 0 01-2.25 2.25h-15a2.25 2.25 0 01-2.25-2.25V6.75m19.5 0A2.25 2.25 0 0019.5 4.5h-15a2.25 2.25 0 00-2.25 2.25m19.5 0v.243a2.25 2.25 0 01-1.07 1.916l-7.5 4.615a2.25 2.25 0 01-2.36 0L3.32 8.91a2.25 2.25 0 01-1.07-1.916V6.75" />
      </svg>
      <span>Please verify your email address before creating watchers. Check your inbox for the verification link.</span>
    </div>

    <!-- Loading skeleton -->
    <div x-show="loading" class="space-y-3">
      <div class="h-16 animate-pulse rounded-lg bg-gray-100"></div>
      <div class="h-16 animate-pulse rounded-lg bg-gray-100"></div>
      <div class="h-16 animate-pulse rounded-lg bg-gray-100"></div>
    </div>

    <!-- Empty state -->
    <div
      x-show="!loading && watchers.length === 0"
      class="card flex flex-col items-center justify-center py-20 text-center"
    >
      <svg class="h-12 w-12 text-gray-300 mb-4" fill="none" viewBox="0 0 24 24" stroke-width="1" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" d="M2.036 12.322a1.012 1.012 0 010-.639C3.423 7.51 7.36 4.5 12 4.5c4.638 0 8.573 3.007 9.963 7.178.07.207.07.431 0 .639C20.577 16.49 16.64 19.5 12 19.5c-4.638 0-8.573-3.007-9.963-7.178z" />
        <path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
      </svg>
      <h3 class="text-base font-semibold text-gray-900 mb-2">No watchers yet</h3>
      <p class="text-sm text-gray-500 mb-4 max-w-xs">
        Browse companies we've already discovered, or add a career page URL manually.
      </p>
      <div class="flex flex-col sm:flex-row gap-3">
        <a href="/discover" class="btn-primary">Browse company catalog</a>
        <button @click="showAddModal = true" class="btn-secondary">Add custom URL</button>
      </div>
    </div>

    <!-- Watcher table -->
    <div x-show="!loading && watchers.length > 0" class="card overflow-hidden">
      <table class="min-w-full divide-y divide-gray-200">
        <thead class="bg-gray-50">
          <tr>
            <th class="px-6 py-3 text-left text-xs font-semibold uppercase tracking-wider text-gray-500">Company</th>
            <th class="px-6 py-3 text-left text-xs font-semibold uppercase tracking-wider text-gray-500 hidden sm:table-cell">URL</th>
            <th class="px-6 py-3 text-left text-xs font-semibold uppercase tracking-wider text-gray-500 hidden md:table-cell">Last checked</th>
            <th class="px-6 py-3 text-left text-xs font-semibold uppercase tracking-wider text-gray-500 hidden md:table-cell">Selector</th>
            <th class="relative px-6 py-3"><span class="sr-only">Actions</span></th>
          </tr>
        </thead>
        <tbody class="divide-y divide-gray-100 bg-white">
          <template x-for="w in watchers" :key="w.id">
            <tr class="hover:bg-gray-50 transition-colors">
              <td class="px-6 py-4">
                <!-- If linked to a catalog company, name is a signals link -->
                <a x-show="w.company_id"
                   :href="`/company?id=${w.company_id}`"
                   class="font-medium text-sm text-brand-600 hover:text-brand-700 transition-colors"
                   x-text="w.company_name"></a>
                <span x-show="!w.company_id"
                      class="font-medium text-gray-900 text-sm"
                      x-text="w.company_name"></span>
                <!-- Signal indicator for catalog watchers -->
                <span x-show="w.company_id"
                      class="ml-1.5 inline-flex items-center rounded-full bg-brand-50 px-1.5 py-0.5 text-[9px] font-semibold text-brand-700">
                  signals
                </span>
              </td>
              <td class="px-6 py-4 hidden sm:table-cell">
                <a
                  :href="w.url"
                  target="_blank"
                  rel="noopener"
                  class="text-xs text-gray-400 hover:text-brand-600 truncate max-w-xs block transition-colors"
                  x-text="w.url.replace('https://', '').replace('http://', '')"
                ></a>
              </td>
              <td class="px-6 py-4 hidden md:table-cell">
                <span
                  class="text-xs text-gray-400"
                  x-text="w.last_checked_at ? formatDate(w.last_checked_at) : 'Never'"
                ></span>
              </td>
              <td class="px-6 py-4 hidden md:table-cell">
                <span
                  x-show="w.job_selector"
                  class="inline-flex items-center rounded bg-gray-100 px-2 py-0.5 font-mono text-xs text-gray-600"
                  x-text="w.job_selector"
                ></span>
                <span x-show="!w.job_selector" class="text-xs text-gray-300">—</span>
              </td>
              <td class="px-6 py-4 text-right">
                <div class="flex items-center justify-end gap-3">
                  <button
                    @click="openEdit(w)"
                    class="text-xs text-gray-400 hover:text-brand-600 transition-colors font-medium"
                  >Edit</button>
                  <button
                    @click="deleteWatcher(w.id, w.company_name)"
                    class="text-xs text-gray-400 hover:text-red-600 transition-colors font-medium"
                  >Remove</button>
                </div>
              </td>
            </tr>
          </template>
        </tbody>
      </table>
    </div>

    <!-- ── Add watcher modal ── -->
    <div
      x-show="showAddModal"
      x-transition.opacity
      class="fixed inset-0 z-50 flex items-center justify-center bg-black/40 px-4"
      @keydown.escape.window="showAddModal = false"
    >
      <div
        class="card w-full max-w-md p-8"
        x-transition.scale
        @click.outside="showAddModal = false"
      >
        <div class="mb-6 flex items-center justify-between">
          <h2 class="text-lg font-semibold text-gray-900">Add a watcher</h2>
          <button @click="showAddModal = false" class="text-gray-400 hover:text-gray-600">
            <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
            </svg>
          </button>
        </div>

        <div x-show="addError" class="alert-error mb-4 text-xs">
          <span x-text="addError"></span>
        </div>

        <form @submit.prevent="addWatcher()" class="space-y-4">
          <div>
            <label class="label" for="add-name">Company name</label>
            <input id="add-name" type="text" required x-model="newWatcher.company_name"
                   class="field" placeholder="Stripe" />
          </div>
          <div>
            <label class="label" for="add-url">Careers page URL</label>
            <input id="add-url" type="url" required x-model="newWatcher.url"
                   class="field" placeholder="https://stripe.com/jobs" />
          </div>
          <div>
            <label class="label" for="add-selector">
              CSS selector
              <span class="font-normal text-gray-400">(optional)</span>
            </label>
            <input id="add-selector" type="text" x-model="newWatcher.job_selector"
                   class="field font-mono text-xs" placeholder="div.job-card h3.job-title" />
            <p class="mt-1 text-xs text-gray-400">
              When set, individual job titles are tracked instead of the full page.
            </p>
          </div>

          <div class="flex gap-3 pt-2">
            <button type="submit" class="btn-primary flex-1" :disabled="addLoading">
              <span x-text="addLoading ? 'Adding…' : 'Add watcher'"></span>
            </button>
            <button type="button" @click="showAddModal = false" class="btn-secondary">
              Cancel
            </button>
          </div>
        </form>
      </div>
    </div>

    <!-- ── Edit watcher modal ── -->
    <div
      x-show="showEditModal"
      x-transition.opacity
      class="fixed inset-0 z-50 flex items-center justify-center bg-black/40 px-4"
      @keydown.escape.window="showEditModal = false"
    >
      <div class="card w-full max-w-md p-8" @click.outside="showEditModal = false">
        <div class="mb-6 flex items-center justify-between">
          <div>
            <h2 class="text-lg font-semibold text-gray-900">Edit watcher</h2>
            <p class="mt-0.5 text-sm text-gray-500" x-text="editTarget?.company_name"></p>
          </div>
          <button @click="showEditModal = false" class="text-gray-400 hover:text-gray-600">
            <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
            </svg>
          </button>
        </div>

        <div x-show="editError" class="alert-error mb-4 text-xs" x-text="editError"></div>

        <form @submit.prevent="saveEdit()" class="space-y-4">
          <div>
            <label class="label" for="edit-url">Career page URL</label>
            <input id="edit-url" type="url" x-model="editForm.url" class="field"
                   placeholder="https://boards.greenhouse.io/stripe" />
          </div>

          <div>
            <label class="label" for="edit-selector">
              CSS selector
              <span class="font-normal text-gray-400">(leave blank for hash-only mode)</span>
            </label>
            <input id="edit-selector" type="text" x-model="editForm.job_selector"
                   class="field font-mono text-xs"
                   placeholder="div.opening a" />
            <div class="mt-2 space-y-1.5">
              <p class="text-xs text-gray-400">Common selectors by platform:</p>
              <div class="flex flex-wrap gap-1.5">
                <button type="button" @click="editForm.job_selector = 'div.opening a'"
                  class="rounded bg-gray-100 px-2 py-1 text-xs text-gray-600 hover:bg-brand-50 hover:text-brand-700 transition-colors">
                  <span class="text-gray-400">Greenhouse</span> · <code>div.opening a</code>
                </button>
                <button type="button" @click="editForm.job_selector = 'div.posting h5'"
                  class="rounded bg-gray-100 px-2 py-1 text-xs text-gray-600 hover:bg-brand-50 hover:text-brand-700 transition-colors">
                  <span class="text-gray-400">Lever</span> · <code>div.posting h5</code>
                </button>
                <button type="button" @click="editForm.job_selector = '.job-list-item h4'"
                  class="rounded bg-gray-100 px-2 py-1 text-xs text-gray-600 hover:bg-brand-50 hover:text-brand-700 transition-colors">
                  <span class="text-gray-400">SmartRecruiters</span> · <code>.job-list-item h4</code>
                </button>
                <button type="button" @click="editForm.job_selector = '.job-card h3'"
                  class="rounded bg-gray-100 px-2 py-1 text-xs text-gray-600 hover:bg-brand-50 hover:text-brand-700 transition-colors">
                  <span class="text-gray-400">Generic card</span> · <code>.job-card h3</code>
                </button>
                <button type="button" @click="editForm.job_selector = '[data-job-id]'"
                  class="rounded bg-gray-100 px-2 py-1 text-xs text-gray-600 hover:bg-brand-50 hover:text-brand-700 transition-colors">
                  <span class="text-gray-400">data attr</span> · <code>[data-job-id]</code>
                </button>
              </div>
            </div>
          </div>

          <!-- Live test panel — always visible so the Test button is easy to find -->
          <div class="rounded-md border border-gray-200 overflow-hidden">
            <div class="flex items-center justify-between bg-gray-50 px-3 py-2 border-b border-gray-200">
              <span class="text-xs font-medium text-gray-600">Selector test</span>
              <button type="button" @click="testSelector()"
                :disabled="testLoading"
                class="text-xs font-medium text-brand-600 hover:text-brand-700 disabled:opacity-50">
                <span x-text="testLoading ? 'Testing…' : 'Run test ↺'"></span>
              </button>
            </div>
            <div class="px-3 py-2.5 min-h-[3rem]">
              <!-- Untested state -->
              <p x-show="!testResult && !testLoading"
                 class="text-xs text-gray-400 italic">
                Click "Run test" to check how many jobs this selector finds on the live page.
              </p>
              <!-- Loading -->
              <p x-show="testLoading" class="text-xs text-gray-400">Fetching page…</p>
              <!-- Result -->
              <div x-show="testResult && !testLoading">
                <p class="text-xs font-semibold mb-1"
                   :class="{
                     'text-green-700': testResult?.count >= 2,
                     'text-amber-600': testResult?.count === 1,
                     'text-red-600':   testResult?.count === 0
                   }">
                  <span x-text="testResult?.count"></span> matches
                  <span class="font-normal ml-1" x-text="'— ' + testResult?.verdict"></span>
                </p>
                <div x-show="testResult?.sample?.length > 0" class="mt-1.5 space-y-0.5">
                  <template x-for="title in testResult?.sample" :key="title">
                    <p class="truncate font-mono text-[11px] text-gray-500" x-text="title"></p>
                  </template>
                </div>
              </div>
              <!-- Error -->
              <p x-show="testError" class="text-xs text-red-600" x-text="testError"></p>
            </div>
          </div>

          <div class="alert-info text-xs">
            Saving resets the baseline — the next worker run will re-establish
            what "current" looks like with the new selector.
          </div>

          <div class="flex gap-3 pt-2">
            <button type="submit" class="btn-primary flex-1" :disabled="editLoading">
              <span x-text="editLoading ? 'Saving…' : 'Save changes'"></span>
            </button>
            <button type="button" @click="showEditModal = false" class="btn-secondary">Cancel</button>
          </div>
        </form>
      </div>
    </div>

  </div>

  <script is:inline>
    function dashboard() {
      return {
        user: null,
        watchers: [],
        loading: true,
        showAddModal: false,
        newWatcher: { company_name: '', url: '', job_selector: '' },
        addError: '',
        addLoading: false,
        showEditModal: false,
        editTarget: null,
        editForm: { url: '', job_selector: '' },
        editError: '',
        editLoading: false,
        testResult: null,
        testError: '',
        testLoading: false,

        async init() {
          // Wait for the app shell to load the user
          window.addEventListener('user-loaded', (e) => {
            this.user = e.detail;
          });
          await this.loadWatchers();
        },

        async loadWatchers() {
          this.loading = true;
          try {
            const res = await fetch('/api/watches');
            if (res.ok) this.watchers = await res.json();
          } finally {
            this.loading = false;
          }
        },

        async addWatcher() {
          this.addError = '';
          this.addLoading = true;
          try {
            const res = await fetch('/api/watches', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({
                company_name: this.newWatcher.company_name,
                url: this.newWatcher.url,
                job_selector: this.newWatcher.job_selector || null,
              }),
            });
            if (res.ok) {
              this.showAddModal = false;
              this.newWatcher = { company_name: '', url: '', job_selector: '' };
              await this.loadWatchers();
            } else {
              const d = await res.json();
              this.addError = d.error || 'Failed to add watcher.';
            }
          } catch {
            this.addError = 'Could not reach the server.';
          } finally {
            this.addLoading = false;
          }
        },

        async deleteWatcher(id, name) {
          if (!confirm(`Remove watcher for "${name}"?`)) return;
          await fetch(`/api/watches/${id}`, { method: 'DELETE' });
          await this.loadWatchers();
        },

        openEdit(w) {
          this.editTarget  = w;
          this.editForm    = { url: w.url, job_selector: w.job_selector || '' };
          this.editError   = '';
          this.testResult  = null;
          this.testError   = '';
          this.showEditModal = true;
        },

        async testSelector() {
          this.testResult  = null;
          this.testError   = '';
          this.testLoading = true;
          try {
            const res = await fetch('/api/selector-test', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({
                url:      this.editForm.url,
                selector: this.editForm.job_selector,
              }),
            });
            if (res.ok) {
              this.testResult = await res.json();
            } else {
              // Defensively parse the error — the body might not be JSON
              let msg = `Server returned ${res.status}`;
              try { const d = await res.json(); msg = d.error || msg; } catch {}
              this.testError = msg;
            }
          } catch (e) {
            // fetch() itself threw — surface the real JS error message
            this.testError = e?.message
              ? `Request failed: ${e.message}`
              : 'Could not reach the server — is the API running?';
          } finally {
            this.testLoading = false;
          }
        },

        async saveEdit() {
          this.editError  = '';
          this.editLoading = true;
          try {
            const body = {
              url:          this.editForm.url || null,
              job_selector: this.editForm.job_selector || null,
            };
            const res = await fetch(`/api/watches/${this.editTarget.id}`, {
              method: 'PATCH',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify(body),
            });
            if (res.ok) {
              this.showEditModal = false;
              await this.loadWatchers();
            } else {
              const d = await res.json();
              this.editError = d.error || 'Failed to save.';
            }
          } catch {
            this.editError = 'Could not reach the server.';
          } finally {
            this.editLoading = false;
          }
        },

        get atLimit() {
          return this.user && this.watchers.length >= this.user.max_watchers;
        },

        formatDate(iso) {
          return new Date(iso).toLocaleString(undefined, {
            month: 'short', day: 'numeric',
            hour: '2-digit', minute: '2-digit',
          });
        },
      };
    }
  </script>
</App>
