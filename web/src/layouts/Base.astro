---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'Career Watch',
  description = 'Monitor company career pages. Get notified the moment new jobs appear.',
} = Astro.props;

const fullTitle = title === 'Career Watch' ? title : `${title} — Career Watch`;
---

<!doctype html>
<html lang="en" class="h-full">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <title>{fullTitle}</title>

    <!-- Inter font -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap"
      rel="stylesheet"
    />

    <!-- Ensure session cookies are forwarded on all API calls.
         Without this, the Vite dev proxy can omit the Cookie header. -->
    <script is:inline>
      (function () {
        const _fetch = window.fetch;
        window.fetch = function (url, opts) {
          if (typeof url === 'string' &&
              (url.startsWith('/api') || url.startsWith('/auth') ||
               url.startsWith('/billing') || url.startsWith('/admin'))) {
            opts = Object.assign({ credentials: 'include' }, opts);
          }
          return _fetch.call(this, url, opts);
        };
      })();
    </script>

    <!-- Alpine.js — is:inline stops Astro from trying to bundle a CDN URL -->
    <script
      is:inline
      defer
      src="https://cdn.jsdelivr.net/npm/alpinejs@3.x.x/dist/cdn.min.js"
    ></script>

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  </head>
  <body class="h-full bg-white text-gray-900 antialiased">
    <slot />
  </body>
</html>
