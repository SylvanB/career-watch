# Production environment — copy to .env.prod and fill in all values.
# Never commit .env.prod to source control.

DATABASE_URL=postgres://career_watch:CHANGE_ME@postgres:5432/career_watch
POSTGRES_PASSWORD=CHANGE_ME
BIND_ADDR=0.0.0.0:8080

# ── Email ──────────────────────────────────────────────────────────────────
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_USER=apikey
SMTP_PASS=SG.CHANGE_ME
SMTP_FROM="Career Watch <no-reply@your-domain.com>"
SMTP_TLS=true

# ── Stripe ─────────────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_live_CHANGE_ME
STRIPE_WEBHOOK_SECRET=whsec_CHANGE_ME
STRIPE_PRICE_PRO=price_CHANGE_ME
STRIPE_PRICE_BUSINESS=price_CHANGE_ME

# ── App ────────────────────────────────────────────────────────────────────
APP_BASE_URL=https://your-domain.com
ADMIN_SECRET=CHANGE_ME_use_openssl_rand_hex_32
COOKIE_SECURE=true

RUST_LOG=info,tower_http=info
