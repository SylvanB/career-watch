{
    email admin@example.com
}

# ── Local dev ─────────────────────────────────────────────────────────────────
# For day-to-day dev, use `make web-dev` instead — Astro's dev server
# handles HMR and proxies API calls automatically.
#
# Use this when you want to test the full built stack locally:
#   make web-build && caddy run

career-watch.localhost {
    root * ./web/dist
    file_server

    # SPA fallback: unknown paths serve index.html
    try_files {path} /index.html

    handle /api/*      { reverse_proxy localhost:8080 }
    handle /auth/*     { reverse_proxy localhost:8080 }
    handle /billing/*  { reverse_proxy localhost:8080 }
    handle /admin/*    { reverse_proxy localhost:8080 }
    handle /healthz    { reverse_proxy localhost:8080 }
}

# ── Production ────────────────────────────────────────────────────────────────
# Uncomment and replace with your real domain.
# Caddy provisions TLS via Let's Encrypt automatically.
