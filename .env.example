DATABASE_URL=postgres://career_watch:password@localhost:5432/career_watch
BIND_ADDR=0.0.0.0:8080

# ── Email ──────────────────────────────────────────────────────────────────
# Local dev: use Mailpit (docker compose up → http://localhost:8025)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Career Watch <no-reply@localhost>"
SMTP_TLS=false

# Production: replace with your real SMTP provider
# SMTP_HOST=smtp.sendgrid.net
# SMTP_PORT=587
# SMTP_USER=apikey
# SMTP_PASS=SG.xxxx
# SMTP_FROM="Career Watch <no-reply@careerwatch.io>"
# SMTP_TLS=true

# ── Stripe ─────────────────────────────────────────────────────────────────
# Get these from https://dashboard.stripe.com/apikeys and your product catalog
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_PRO=price_...
STRIPE_PRICE_BUSINESS=price_...

# ── App ────────────────────────────────────────────────────────────────────
# Must point at the FRONTEND URL (Astro), not the Rust API.
# Links in emails (verify, password reset) go here so users land on a page,
# not a raw API endpoint.
# Local dev (Astro dev server): http://localhost:4321
# Production: https://your-domain.com
APP_BASE_URL=http://localhost:4321
ADMIN_SECRET=change-me-in-production
COOKIE_SECURE=false   # set to true in production (requires HTTPS)

# ── Local LLM (Ollama) ─────────────────────────────────────────────────────
# Two models, two tasks:
#
# OLLAMA_MODEL            — discovery: selector detection + URL crawl hints
#                           Needs general reasoning. Recommended: qwen2.5:3b
#
# OLLAMA_EXTRACTION_MODEL — worker: HTML → structured JSON job extraction
#                           Purpose-built model, beats 32B+ on this task.
#                           Recommended: GFalcon-UA/ReaderLM-v2:Q8
#                           Defaults to OLLAMA_MODEL when not set.
#
# Quick start:
#   docker compose --profile ai up -d ollama
#   docker compose exec ollama ollama pull qwen2.5:3b
#   docker compose exec ollama ollama pull GFalcon-UA/ReaderLM-v2:Q8
#
# Use a single model for both (simpler, slightly lower quality):
#   # just leave OLLAMA_EXTRACTION_MODEL unset
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=qwen2.5:3b
OLLAMA_EXTRACTION_MODEL=GFalcon-UA/ReaderLM-v2:Q8

RUST_LOG=info,tower_http=info
