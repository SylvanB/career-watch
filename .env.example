DATABASE_URL=postgres://career_watch:password@localhost:5432/career_watch
BIND_ADDR=0.0.0.0:8080

# ── Email ──────────────────────────────────────────────────────────────────
# Local dev: use Mailpit (docker compose up → http://localhost:8025)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Career Watch <no-reply@localhost>"
SMTP_TLS=false

# Production: replace with your real SMTP provider
# SMTP_HOST=smtp.sendgrid.net
# SMTP_PORT=587
# SMTP_USER=apikey
# SMTP_PASS=SG.xxxx
# SMTP_FROM="Career Watch <no-reply@yourdomain.com>"
# SMTP_TLS=true

RUST_LOG=info,tower_http=info
